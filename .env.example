# ==============================================================================
# INVEYS Docker Environment Configuration
# Salin file ini menjadi .env sebelum menjalankan docker compose:
# cp .env.example .env
# ==============================================================================

# --- Konfigurasi Domain & Jaringan ---
# Port eksternal saat menjalankan mode standalone (docker-compose.yml)
INVEYS_PORT=3000

# Nama domain VPS Anda (digunakan untuk auto-SSL HTTPS Caddy / Traefik)
DOMAIN=inveys.io

# Daftar host/IP yang diizinkan (dipisahkan koma) untuk keamanan Origin & Host
ALLOWED_HOSTS=inveys.io,www.inveys.io,187.77.134.249,localhost,127.0.0.1

# Traefik Reverse Proxy (Opsional jika menggunakan docker-compose.traefik.yml):
# TRAEFIK_NETWORK=traefik_default
# TRAEFIK_CERT_RESOLVER=letsencrypt
# TRAEFIK_ENTRYPOINT=websecure
# INVEYS_HOST_PORT=3000

# --- Multimodal AI Gateway (Opsional) ---
# Aktifkan salah satu atau beberapa model sesuai kebutuhan Anda:

# Google Gemini (Rekomendasi Utama: Multimodal & Cepat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta AI / Muse Spark
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3

# 9Router Gateway (Self-hosted / OpenAI Compatible)
# Masukkan API Key 9Router Anda (contoh: sk-...)
NINEROUTER_API_KEY=
# Model atau Combo ID dari dashboard 9Router (contoh: claude-3-5-sonnet, gpt-4o, deepseek-chat)
NINEROUTER_MODEL=claude-3-5-sonnet
# Base URL endpoint (akhiri dengan /v1). Jika 9Router berjalan di host VPS dan INVEYS di Docker, gunakan http://host.docker.internal:20128/v1
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# --- Integrasi Telegram Bot (Opsional) ---
# Dapatkan bot token melalui @BotFather dan chat ID private Anda:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
