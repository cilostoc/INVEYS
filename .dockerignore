# Git & VCS
.git
.gitignore

# Documentation, tests & non-runtime scripts (kept out of runtime image)
docs/
tests/
scripts/*
!scripts/build.py
!scripts/build-manifest.json
!scripts/create_admin.py
*.md
!README.md
!CHANGELOG.md

# macOS / OS files
.DS_Store
.AppleDouble
.LSOverride
._*

# Python & Node artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.env.*
node_modules/
npm-debug.log*

# Local SQLite databases & backups
.inveys/
inbox.sqlite3*
*.sqlite3*
backups/

# Scratch & Temporary files
scratch/
.system_generated/
*.log
